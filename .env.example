# Copy to .env and fill in. NEVER commit .env.
# All camera credentials/URLs live here; config/cameras.yaml only references env vars by name.

# --- Ops ---
PSO_TIMEZONE=Asia/Karachi
PSO_LOG_LEVEL=INFO
PSO_API_HOST=0.0.0.0
PSO_API_PORT=8080

# --- Storage ---
PSO_DB_URL=sqlite+aiosqlite:///./data/pso.db
PSO_SNAPSHOT_DIR=./data/snapshots
PSO_RETENTION_DAYS=30

# --- Inference ---
PSO_YOLO_WEIGHTS=./models/yolo11n.pt
PSO_INFERENCE_FPS=8
PSO_CONF_THRESHOLD=0.35
PSO_DEVICE=auto             # cpu | cuda | auto

# --- Camera 1 (example: PTZ over forecourt) ---
CAM_PTZ1_RTSP=rtsp://user:pass@192.168.1.108:554/cam/realmonitor?channel=1&subtype=0
CAM_PTZ1_HOST=192.168.1.108
CAM_PTZ1_ONVIF_PORT=80
CAM_PTZ1_USER=admin
CAM_PTZ1_PASS=change-me

# --- Camera 2 (example: wide fixed) ---
CAM_WIDE1_RTSP=rtsp://user:pass@192.168.1.109:554/cam/realmonitor?channel=1&subtype=0
CAM_WIDE1_HOST=192.168.1.109
CAM_WIDE1_ONVIF_PORT=80
CAM_WIDE1_USER=admin
CAM_WIDE1_PASS=change-me
